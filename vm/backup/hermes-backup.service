# Installed by hermes-addon-backup as /etc/systemd/system/hermes-backup.service; started by hermes-backup.timer.
[Unit]
Description=Encrypted backup of your agents to Google Drive (agent-automation)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hermes-backup
Environment=HOME=/root
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=2h
