# Installed by crew-addon-backup as /etc/systemd/system/crew-backup.timer. The server's clock is set to your timezone by the
# installer, so this is about 04:20 your time; a night the server was off is caught up when it starts again.
[Unit]
Description=Nightly backup of your agents at about 04:20

[Timer]
OnCalendar=*-*-* 04:20:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
