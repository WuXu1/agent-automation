#!/usr/bin/env bash
# crew-backup: the nightly encrypted backup of everything on this server that the kit cannot rebuild. It goes to your Google Drive
# (folder agent-automation-backups) and nothing of it stays on the server afterwards except a one-line status.
# Installed by crew-addon-backup as /usr/local/sbin/crew-backup (root-owned, outside /data, so no agent can change what root runs) and
# started every night by crew-backup.timer. Silent when it works; your chief of staff sends you a Telegram note when it fails.
#   sudo crew-backup                    make one now (a Telegram note if it fails)
#   sudo BACKUP_QUIET=1 crew-backup     the same, never a Telegram note
# Last result: cat /var/backups/crew-backup/last-status        Restore: sudo crew-restore (docs/BACKUPS.md)
#
# In it: /data/.hermes (every agent's settings and keys, sessions, the board, scheduled jobs, your notebooks in owner/, crew.json, the
# memory server's settings), /data/workspace, /data/tools (the tools' data, e.g. the Gmail sign-in) and the shared memory's Postgres
# databases (mem0, mem0_app) as postgres/*.dump. Every SQLite database is copied with SQLite's own backup call, as the hermes user (root
# must never create -wal/-shm files the agents then cannot open); those copies are under sqlite/ in the archive and the live database
# files are left out of the rest. Not in it: what ./install.sh rebuilds (Hermes itself, venvs, node_modules, caches, logs, the memory
# server's code), and this backup's own passphrase and Google sign-in.
set -uo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
[ "$(id -u)" = 0 ] || exec sudo BACKUP_QUIET="${BACKUP_QUIET:-}" "$0" "$@"
cd /

CONF=/etc/crew-backup                   # passphrase and rclone.conf (the Google Drive sign-in), both root-only
OUT=/var/backups/crew-backup            # last-status; tonight's archive only while it is being sent
STAGE=/var/tmp/crew-backup-stage        # database copies, deleted at the end
FOLDER=agent-automation-backups         # in your Google Drive (My Drive)
HH=/data/.hermes
HERMES=/home/hermes/.local/bin/hermes
PY=/opt/hermes/hermes-agent/venv/bin/python
[ -x "$PY" ] || PY=/usr/bin/python3
NAME="crew-backup-$(date +%Y-%m-%d-%H%M).tar.gz.gpg"
RC=(rclone --config "$CONF/rclone.conf")

KEEP_DAYS=35                            # change with: echo 14 | sudo tee /etc/crew-backup/keep-days  (7 to 365)
if [ -s "$CONF/keep-days" ]; then
  k="$(tr -dc '0-9' < "$CONF/keep-days")"
  [ -n "$k" ] && [ "$k" -ge 7 ] && [ "$k" -le 365 ] && KEEP_DAYS="$k"
fi

# Rebuildable folders inside every agent's home (the chief's and each profile's): never backed up.
HSKIP=(tools installs cache logs lsp bin audio_cache image_cache)

exec 9>/run/crew-backup.lock
flock -n 9 || { echo "a backup (or a restore) is already running"; exit 0; }

OWNER="$(jq -r '.owner.name // empty' "$HH/crew.json" 2>/dev/null || true)"
WARN=""

tell_owner() {
  [ -z "${BACKUP_QUIET:-}" ] || return 0          # BACKUP_QUIET=1: a run by hand, no Telegram
  [ -x "$HERMES" ] || return 0
  timeout 90 runuser -u hermes -- env HOME=/home/hermes HERMES_HOME="$HH" PATH=/home/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin \
    "$HERMES" send --to telegram -q "$1" >/dev/null 2>&1 </dev/null || true
}

status() {   # one line, readable by anyone (no secrets in it): the dashboard and crew-doctor can show it
  install -d -m 755 "$OUT"
  echo "$(date -Is) $*" > "$OUT/last-status"
  chmod 644 "$OUT/last-status"
}

fail() {
  status "FAILED: $*"
  echo "backup failed: $*" >&2
  tell_owner "${OWNER:+$OWNER, }the nightly backup of your server failed: $*. The earlier backups in your Google Drive are untouched. On the server, 'sudo crew-backup' tries again; 'journalctl -u crew-backup' has the details."
  rm -rf "$STAGE" "$OUT/$NAME.part"
  exit 1
}

[ -s "$CONF/passphrase" ] || fail "no backup passphrase is set (run: sudo crew-addon backup)"
[ -s "$CONF/rclone.conf" ] || fail "Google Drive is not connected (run: sudo crew-addon backup)"
command -v rclone >/dev/null || fail "rclone is not installed (run: sudo crew-addon backup)"
command -v gpg >/dev/null || fail "gpg is not installed (sudo apt install gnupg)"
id hermes >/dev/null 2>&1 || fail "there is no 'hermes' user on this server"
free_kb="$(df -Pk /var/tmp | awk 'NR==2 {print $4}')"
[ "${free_kb:-0}" -gt 1048576 ] || fail "less than 1 GB is free on the server's disk"

install -d -m 755 "$OUT"
rm -rf "$STAGE"
install -d -o hermes -g hermes -m 700 "$STAGE"

SRC=()
for p in "$HH" /data/workspace /data/tools; do [ -e "$p" ] && SRC+=("$p"); done
[ -d "$HH" ] || fail "$HH is missing (is this an agent-automation server?)"

# 1. consistent copies of every SQLite database, made by the hermes user
PRUNE=()
for d in "${HSKIP[@]}"; do PRUNE+=(-path "$HH/$d" -o -path "$HH/profiles/*/$d" -o); done
PRUNE+=(-path /data/tools/mem0-src -o -path /data/tools/mem0-cache -o -name node_modules -o -name venv -o -name .venv
        -o -name '*-venv' -o -name __pycache__)
find "${SRC[@]}" -xdev \( "${PRUNE[@]}" \) -prune \
     -o -type f \( -name '*.db' -o -name '*.sqlite' -o -name '*.sqlite3' \) -print0 \
  | runuser -u hermes -- "$PY" -I -c '
import os, shutil, sqlite3, sys
stage, bad = sys.argv[1], []
for src in sys.stdin.read().split("\0"):
    if not src:
        continue
    dst = os.path.join(stage, "sqlite", src.lstrip("/"))
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    try:
        s = sqlite3.connect(f"file:{src}?mode=ro", uri=True, timeout=60)
        d = sqlite3.connect(dst)
        s.backup(d)
        d.close(); s.close()
    except Exception as exc:                      # not readable as a database: keep the raw file, say so in the log
        try:
            shutil.copy2(src, dst)
        except OSError:
            pass
        bad.append(f"{src} ({type(exc).__name__})")
if bad:
    print("raw copies instead of SQLite backups: " + "; ".join(bad), file=sys.stderr)
' "$STAGE" || fail "the database copies could not be made"

# 1b. the shared memory's Postgres databases (their files live in /var/lib/postgresql, which the archive does not hold): dumps made by
#     the postgres user; this root shell does the redirect, so the files land in the staging folder
install -d -m 700 "$STAGE/postgres"
if runuser -u postgres -- pg_isready -q 2>/dev/null; then
  for db in mem0 mem0_app; do
    runuser -u postgres -- psql -tAc "SELECT 1 FROM pg_database WHERE datname='$db'" 2>/dev/null | grep -q 1 || continue
    runuser -u postgres -- pg_dump --format=custom "$db" > "$STAGE/postgres/$db.dump" 2>"$STAGE/pg.err" \
      || fail "the shared memory's database $db could not be saved ($(head -c 200 "$STAGE/pg.err"))"
  done
  rm -f "$STAGE/pg.err"
else
  WARN="the shared memory's database (Postgres) was not running, so tonight's backup has the agents' files but not the shared memory"
fi

# 2. one archive, encrypted with your passphrase (AES-256), then checked by decrypting it again
EXCL=()
for d in "${HSKIP[@]}"; do EXCL+=(--exclude="$HH/$d" --exclude="$HH/profiles/*/$d"); done
for x in db db-wal db-shm db-journal sqlite sqlite-wal sqlite-shm sqlite-journal sqlite3 sqlite3-wal sqlite3-shm sqlite3-journal; do
  EXCL+=(--exclude="/data/*.$x")
done
EXCL+=(--exclude=/data/tools/mem0-src --exclude=/data/tools/mem0-cache --exclude="$HH/.restart_pending.json"
       --exclude=node_modules --exclude=venv --exclude=.venv --exclude='*-venv' --exclude=__pycache__)
tar --create --gzip --file=- "${EXCL[@]}" \
    --warning=no-file-changed --warning=no-file-removed --warning=no-file-ignored --ignore-failed-read \
    "${SRC[@]}" -C "$STAGE" sqlite postgres 2> >(grep -v "Removing leading" >&2) \
  | gpg --batch --yes --quiet --pinentry-mode loopback --symmetric --cipher-algo AES256 --compress-algo none \
        --s2k-mode 3 --s2k-digest-algo SHA512 --s2k-count 65011712 \
        --passphrase-file "$CONF/passphrase" -o "$OUT/$NAME.part"
codes=("${PIPESTATUS[@]}")
[ "${codes[0]}" -le 1 ] || fail "the archive could not be written (tar exit ${codes[0]})"      # 1 = a file changed while read: fine
[ "${codes[1]}" -eq 0 ] || fail "the archive could not be encrypted (gpg exit ${codes[1]})"
gpg --batch --quiet --pinentry-mode loopback --passphrase-file "$CONF/passphrase" -d "$OUT/$NAME.part" 2>/dev/null \
  | tar --list --gzip --file=- >/dev/null || fail "the new archive did not read back"
mv "$OUT/$NAME.part" "$OUT/$NAME"
rm -rf "$STAGE"
SIZE="$(du -h "$OUT/$NAME" | cut -f1)"

# 3. off the server, to your Google Drive. The sign-in has only the drive.file permission (it sees just the files rclone made) and lives
#    in a root-only file; rclone checks the checksum after the upload. rclone's shared Google key is sometimes rate-limited for everybody
#    (403 rateLimitExceeded), so it tries again for about ten minutes before giving up.
sent=""
for attempt in 1 2 3 4 5 6; do
  if "${RC[@]}" copyto "$OUT/$NAME" "gdrive:$FOLDER/$NAME" \
       --retries 3 --low-level-retries 5 --timeout 10m --contimeout 60s >/dev/null 2>"$OUT/drive.err"; then sent=1; break; fi
  [ "$attempt" -lt 6 ] && sleep 90
done
if [ -z "$sent" ]; then
  why="details: sudo cat $OUT/drive.err"
  grep -qi quota "$OUT/drive.err" && why="your Google Drive looks full (free some space, or keep fewer days: docs/BACKUPS.md)"
  grep -qiE 'invalid_grant|unauthorized|token' "$OUT/drive.err" && why="the Google sign-in needs renewing: ./crew backup-login on your laptop, then sudo crew-addon backup"
  grep -qi rateLimitExceeded "$OUT/drive.err" && why="Google's shared limit for rclone was busy; it usually works the next night"
  # keep tonight's archive (encrypted) on the server until the next good night, but never more than one
  for f in "$OUT"/crew-backup-*.tar.gz.gpg; do [ -e "$f" ] && [ "$f" != "$OUT/$NAME" ] && rm -f -- "$f"; done
  fail "the upload to Google Drive failed after 6 tries ($why)"
fi
rm -f "$OUT/drive.err"
# Keep KEEP_DAYS days. Deleted for good (not to Drive's bin), so old archives never take up space unseen.
"${RC[@]}" delete "gdrive:$FOLDER" --min-age "${KEEP_DAYS}d" --include 'crew-backup-*.tar.gz.gpg' --drive-use-trash=false \
  >/dev/null 2>&1 || true

# 4. nothing stays on the server (a leftover from an earlier failed night goes too, now that tonight's is safe)
rm -f -- "$OUT"/crew-backup-*.tar.gz.gpg
if [ -n "$WARN" ]; then
  status "ok $NAME $SIZE | drive | warning: $WARN"
  tell_owner "${OWNER:+$OWNER, }last night's server backup is in your Google Drive, but $WARN. 'sudo crew-doctor' on the server shows what is not running."
else
  status "ok $NAME $SIZE | drive"
fi
echo "backup ok: $NAME ($SIZE) is in your Google Drive, folder $FOLDER"
