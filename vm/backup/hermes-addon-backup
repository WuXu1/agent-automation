#!/usr/bin/env bash
# hermes-addon-backup: nightly encrypted backups of your agents to your own Google Drive (optional, free). Set up once:
#   hermes addon backup  (laptop)  or  sudo hermes-addon backup  (server)   set up; run it again to change the passphrase, the Google
#                                      account or how many days are kept
#   sudo hermes-addon-backup             the same: change the passphrase, the Google account or how many days are kept
#   sudo hermes-addon-backup --status    when the last backup ran, how it went, what is on Drive
#   sudo hermes-addon-backup --off       stop the nightly backups (the backups already in your Drive stay there)
# Before setting up, have your laptop ready for the Google sign-in: hermes backup-login (docs/BACKUPS.md explains it all).
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo bash "$0" "$@"
. /opt/agent-automation/vm/lib.sh
. "$KIT/vm/backup/lib-backup.sh"
umask 077

case "${1:-}" in
  --off|off)
    systemctl disable --now hermes-backup.timer >/dev/null 2>&1 || true
    cj_set '.features.backup' false
    ok "Nightly backups are off. The backups already in your Google Drive stay there (folder $BK_FOLDER)."
    note "Your passphrase and Google sign-in stay on the server (root only), so 'sudo hermes-addon backup' turns them back on quickly."
    note "To cut the Google link completely: sudo rm $BK_CONF/rclone.conf, and remove 'rclone' at https://myaccount.google.com/permissions"
    exit 0 ;;
  --status|status)
    if [ -s "$BK_OUT/last-status" ]; then say "  Last backup: $(cat "$BK_OUT/last-status")"; else say "  No backup has run yet."; fi
    if systemctl is-enabled --quiet hermes-backup.timer 2>/dev/null; then
      say "  Next one:    $(systemctl show hermes-backup.timer -p NextElapseUSecRealtime --value 2>/dev/null)"
    else say "  Nightly backups are off (sudo hermes-addon backup turns them on)."; fi
    if drive_ok; then
      say "  Newest backups in your Google Drive (folder $BK_FOLDER):"
      rclone --config "$BK_CONF/rclone.conf" lsf --format tsp --separator '|' "gdrive:$BK_FOLDER" --include '*.tar.gz.gpg' 2>/dev/null \
        | sort -r | head -n 5 | awk -F'|' '{printf "    %s  %6.0f MB  %s\n", $1, $2/1048576, $3}'
      n="$(rclone --config "$BK_CONF/rclone.conf" lsf "gdrive:$BK_FOLDER" --include '*.tar.gz.gpg' 2>/dev/null | wc -l)"
      say "  $n backups in all."
    elif [ -s "$BK_CONF/rclone.conf" ]; then warn "The Google sign-in no longer works: hermes backup-login on your laptop, then sudo hermes-addon backup"
    fi
    exit 0 ;;
  ""|--setup) ;;
  -h|--help) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

[ -t 0 ] || [ -r /dev/tty ] || die "Run this in a terminal on the server (it asks for a passphrase at a hidden prompt)."
step "Nightly backups to your Google Drive"
say "  Every night at about 04:20 the server packs up everything that can't be rebuilt (your agents' settings and keys, their"
say "  memory, chats, the board, your notebooks), locks it with a passphrase only you know, and puts it in your Google Drive."
say "  Nothing is kept on the server. It costs nothing: each backup is up to about 250 MB of Drive space (usually less)."
install -d -m 700 "$BK_CONF"
ensure_rclone

# 1. the passphrase
step "1/4  The passphrase that locks your backups"
if [ -s "$BK_CONF/passphrase" ] && confirm "Keep the passphrase you chose before?" y; then
  ok "Passphrase kept"
else
  say "  Choose a passphrase of at least 12 characters (a few random words with spaces is good)."
  say "  ${B}Write it down now${N}: in your password manager, or on paper somewhere safe. Without it the backups can't be opened,"
  say "  by you or by anyone else, and there is no reset. (It stays on this server too, readable by root only, so the nightly"
  say "  job can lock the backups; your agents can't read it.)"
  done_pw=""
  for _ in 1 2 3; do
    p1="$(read_hidden "Passphrase")"
    if [ "${#p1}" -lt 12 ]; then warn "Too short: at least 12 characters, please."; continue; fi
    p2="$(read_hidden "The same again")"
    if [ "$p1" != "$p2" ]; then warn "They didn't match. Once more."; continue; fi
    printf '%s' "$p1" > "$BK_CONF/passphrase.new"          # printf is a shell builtin: never on a command line
    chmod 600 "$BK_CONF/passphrase.new"; mv -f "$BK_CONF/passphrase.new" "$BK_CONF/passphrase"
    done_pw=1; break
  done
  p1=""; p2=""
  [ -n "$done_pw" ] || die "No passphrase was saved, so nothing else was changed. Run it again when you're ready."
  ok "Passphrase saved (root only). A new passphrase applies to new backups; older ones still open with the one they were made with."
fi

# 2. Google Drive
step "2/4  Connect your Google Drive"
if drive_ok && confirm "Google Drive is already connected. Keep that sign-in?" y; then
  ok "Google Drive sign-in kept"
  rclone --config "$BK_CONF/rclone.conf" mkdir "gdrive:$BK_FOLDER" >/dev/null 2>&1 || true
else
  setup_drive || die "Google Drive isn't connected, so the nightly backup isn't switched on. Run this again with a fresh token."
fi

# 3. how long to keep, the nightly job
step "3/4  How long to keep backups"
note "Google's free 15 GB is shared with Gmail and Photos. 35 days x up to 250 MB is up to about 9 GB; fewer days uses less."
cur="$(tr -dc '0-9' 2>/dev/null < "$BK_CONF/keep-days" || true)"
while :; do
  d="$(ask "Keep backups for how many days? (7 to 365)" "${cur:-35}")"
  case "$d" in ''|*[!0-9]*) warn "A number, please." ;; *) [ "$d" -ge 7 ] && [ "$d" -le 365 ] && break; warn "Between 7 and 365, please." ;; esac
done
printf '%s\n' "$d" > "$BK_CONF/keep-days"; chmod 600 "$BK_CONF/keep-days"
ok "Backups older than $d days are deleted from your Drive (for good, not into the bin)"

install -o root -g root -m 755 "$KIT/vm/backup/hermes-backup" /usr/local/sbin/hermes-backup
install -o root -g root -m 755 "$KIT/vm/backup/hermes-restore" /usr/local/sbin/hermes-restore
install -o root -g root -m 755 "$KIT/vm/backup/hermes-addon-backup" /usr/local/sbin/hermes-addon-backup
install -o root -g root -m 644 "$KIT/vm/backup/hermes-backup.service" /etc/systemd/system/hermes-backup.service
install -o root -g root -m 644 "$KIT/vm/backup/hermes-backup.timer" /etc/systemd/system/hermes-backup.timer
systemctl daemon-reload
systemctl enable --now --quiet hermes-backup.timer
cj_set '.features.backup' true
ok "Nightly backup switched on (about 04:20 your time; a missed night is caught up when the server is back)"

# 4. the first one, now
step "4/4  Making the first backup now (a minute or two)"
if BACKUP_QUIET=1 /usr/local/sbin/hermes-backup; then
  ok "$(cat "$BK_OUT/last-status")"
  say
  say "  Done. Check it in your browser: https://drive.google.com → My Drive → ${B}$BK_FOLDER${N}"
  say "  From now on it's silent when it works; $(cj '.agents[0].name' || echo 'your chief of staff') tells you on Telegram if a night fails."
  say "  Any time: ${B}sudo hermes-addon-backup --status${N}.  To restore: ${B}sudo hermes-restore${N} (docs/BACKUPS.md)."
  say "  ${B}Have you written down the passphrase?${N} Without it these backups can't be opened."
else
  warn "The first backup didn't work: $(cat "$BK_OUT/last-status" 2>/dev/null)"
  say "  The nightly job is on and will try again tonight. Fix what it says, then: sudo hermes-backup"
  exit 1
fi
