+def _unattended_consolidation_allowed() -> bool:
+    """Operator opt-in: let an unattended review fork apply ``replace``/``remove`` directly.
+
+    Default False keeps the fail-closed staging path. Reads the per-profile config key
+    ``memory.allow_unattended_consolidation``. Turning it on trades the human approval
+    round-trip for an unattended model rewriting memory entries, so every applied op is
+    snapshotted first by :func:`_snapshot_memory_before_unattended_write` — when nobody
+    reviews the staged proposals, the pre-write file is the only recovery path.
+    """
+    try:
+        from hermes_cli.config import cfg_get, load_config
+        return is_truthy_value(
+            cfg_get(load_config(), "memory", "allow_unattended_consolidation", default=False)
+        )
+    except Exception:
+        logger.warning("Could not read memory.allow_unattended_consolidation; staging instead", exc_info=True)
+        return False
+
+
+def _snapshot_memory_before_unattended_write(store, target: str) -> None:
+    """Copy the store file aside (newest 100 snapshots kept) before an unattended write."""
+    try:
+        import shutil
+        import time
+        src = store._path_for(target)
+        if src is None or not src.exists():
+            return
+        dest_dir = get_hermes_home() / "backups" / "memory"
+        dest_dir.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(src, dest_dir / f"{src.name}.{time.strftime('%Y%m%d-%H%M%S')}.bak")
+        for stale in sorted(dest_dir.glob("*.bak"))[:-100]:
+            stale.unlink(missing_ok=True)
+    except Exception:
+        logger.warning("Memory snapshot before unattended write failed", exc_info=True)
+
+
