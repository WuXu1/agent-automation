diff --git a/gateway/run_voice.py b/gateway/run_voice.py
index 58d45bc00ff..e819a3dc1c5 100644
--- a/gateway/run_voice.py
+++ b/gateway/run_voice.py
@@ -28,6 +28,103 @@ logger = logging.getLogger("gateway.run")  # log-record parity with the origin m
 # Adapter-side per-chat auto-TTS override sets (``/voice off`` vs explicit ``/voice on``/``tts``).
 _OFF_SET, _ON_SET = "_auto_tts_disabled_chats", "_auto_tts_enabled_chats"
 _VOICE_MODES = {"off", "voice_only", "all"}
+# A reply's own attachment directive (``MEDIA:<path>``) and the tag that marks it as a voice note.
+# Path forms mirror the delivery parser in ``gateway.platforms.base`` (quoted or bare, absolute or
+# remote — a relative ``MEDIA:file.mp3`` is prose the pipeline never delivers).
+_MEDIA_TAG_PATH_RE = re.compile(
+    r"""MEDIA:\s*(?P<quoted>`[^`\n]+?`|"[^"\n]+?"|'[^'\n]+?'|(?P<bare>\S+))""")
+_AUDIO_EXT_FALLBACK = frozenset(
+    {".ogg", ".opus", ".oga", ".mp3", ".m4a", ".wav", ".flac", ".aac"})
+_TTS_TOOL_NAME = "text_to_speech"
+
+
+def _media_tag_paths(response: str) -> list:
+    """Paths a reply attaches with ``MEDIA:`` tags, in tag order, dequoted."""
+    text = str(response or "")
+    if "MEDIA:" not in text:
+        return []
+    paths = []
+    for m in _MEDIA_TAG_PATH_RE.finditer(text):
+        raw = (m.group("quoted") or m.group("bare") or "").strip()
+        if raw[:1] in ("`", '"', "'") and raw[-1:] == raw[:1]:
+            raw = raw[1:-1]
+        path = raw.strip().strip("<>").rstrip(",;.")
+        if path:
+            paths.append(path)
+    return paths
+
+
+def _deliverable_path(path: str) -> bool:
+    """True for the path forms the delivery pipeline actually sends (absolute or remote)."""
+    lowered = path.lower()
+    return bool(
+        lowered.startswith(("/", "~/", "http://", "https://"))
+        or re.match(r"^[a-z]:[/\\]", lowered)
+    )
+
+
+def _reply_attaches_own_audio(response: str, platform) -> bool:
+    """True when the reply attaches its own audio file with a ``MEDIA:`` tag — the agent's own
+    voice note, whether it came from ``text_to_speech`` or from any other tool. Used to tell
+    "this reply already has audio" (deliver it, add nothing) from "the agent merely called the
+    TTS tool" (it may have failed, so the automatic note must still be sent).
+
+    Any audio extension counts, not just the ones the platform would send as a voice bubble: on
+    Telegram a bare ``.ogg``/``.opus`` goes out as an audio document, and treating that as "no
+    audio here" would answer with a second, spoken copy of the same reply."""
+    is_voice_tag = "[[audio_as_voice]]" in str(response or "")
+    for path in _media_tag_paths(response):
+        if not _deliverable_path(path):
+            continue
+        ext = os.path.splitext(path)[1].lower()
+        if ext in _AUDIO_EXT_FALLBACK or _ext_is_platform_audio(platform, ext, is_voice_tag):
+            return True
+    return False
+
+
+def _ext_is_platform_audio(platform, ext: str, is_voice: bool) -> bool:
+    """``should_send_media_as_audio`` without the import cycle, defaulting to False."""
+    try:
+        from gateway.platforms.base import should_send_media_as_audio
+        return bool(should_send_media_as_audio(platform, ext, is_voice=is_voice))
+    except Exception:
+        return False
+
+
+def _reply_attaches_media(response: str) -> bool:
+    """True when the reply attaches any file with a ``MEDIA:`` tag. The adapter's auto-TTS gate
+    skips a reply that carries media (``not media_files``), so a deferral to it is only honest
+    when the reply carries none."""
+    return any(_deliverable_path(p) for p in _media_tag_paths(response))
+
+
+def _count_tts_tool_calls(agent_messages: list) -> int:
+    """``text_to_speech`` calls in this turn (counted from the last user message on). Diagnostic
+    only — the deferral decision reads the reply's own attachment, never the bare call."""
+    messages = agent_messages or []
+    start = next((i for i, m in reversed(list(enumerate(messages)))
+                  if isinstance(m, dict) and m.get("role") == "user"), 0)
+    return sum(1 for msg in messages[start:]
+               if isinstance(msg, dict) and msg.get("role") == "assistant"
+               for tc in (msg.get("tool_calls") or [])
+               if ((tc or {}).get("function") or {}).get("name") == _TTS_TOOL_NAME)
+
+
+def queued_voice_event(turn_ctx, message_type):
+    """Rebuild a turn's inbound event for the queued-delivery lane, which carries only the source
+    and the turn's message type — enough for both voice gates, which read no other event field.
+    Returns None when there is no source to deliver to."""
+    from gateway.platforms.event import MessageEvent, MessageType
+    source = getattr(turn_ctx, "source", None)
+    if source is None:
+        return None
+    raw = getattr(message_type, "value", message_type)
+    try:
+        mtype = MessageType(str(raw).lower()) if raw else MessageType.TEXT
+    except Exception:  # unknown value: not voice input, so the mode gate decides alone
+        mtype = MessageType.TEXT
+    return MessageEvent(text="", source=source, message_type=mtype,
+                        message_id=getattr(turn_ctx, "event_message_id", None))
 
 
