[Unit]
Description=Command Center dashboard bridge (serves the page and a small /api in front of Mem0)
After=network-online.target mem0-server.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/data/tools/hermes-dash
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I /data/tools/hermes-dash/bridge.py --config /data/.hermes/hermes-dash/config.json
Restart=always
RestartSec=5

# It reads, makes the confirmed writes of actions.py as hermes, and talks only to services on this machine. ProtectSystem=full, not strict: reading the board's
# SQLite file (WAL mode) needs its -shm file to be writable, even for a read-only connection.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
# About 20 MB idle; a hermes CLI call (an agent edit, a new card) briefly needs ~130 MB more.
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
